# 同一份 .env 参数结构和 docker-compose.yml 在本地、云端使用。
# 注释请单独一行；值后写注释时必须留空格，避免 false#说明 被当成值。
# 项目名同时决定默认数据卷名；已有环境保持当前项目名，不能随意改名。
# 云端现行 .env 未设置此键，走 compose 默认 liutech，对应既有卷 liutech_mysql_data。
COMPOSE_PROJECT_NAME=liutech
# 本机替代（对应 liutech-local_mysql_data / liutech-local_uploads）：COMPOSE_PROJECT_NAME=liutech-local

# Nginx 两边使用同一份 HTTPS 配置；本地通常直接使用 Web/Admin 的3000/3001端口。
# 使用 Nginx 入口时，证书文件由下方 NGINX_SSL_PATH 挂载，不改变镜像启动方式。
NGINX_BIND_IP=0.0.0.0
# 本机替代：NGINX_BIND_IP=127.0.0.1
# 上面只保留一行生效：云端公开 Nginx 入口，本机只监听环回。
# 内部服务宿主机端口在两边都会发布，但只绑到下面这个地址；服务间仍走容器网络。
# 云端发布前确认 3306/8080/8081/3000/3001 在宿主机空闲，否则 up 会因端口占用失败。
INTERNAL_BIND_IP=127.0.0.1

# 基础端口配置
WEB_PORT=3000
ADMIN_PORT=3001
BACKEND_PORT=8080
MYSQL_PORT=3306
NGINX_HTTP=80
NGINX_HTTPS=443
NGINX_ADMIN_PORT=81
AI_PORT=8081

# JWT 签名密钥：仅主服务用于签发和校验用户 token
# 生成命令：openssl rand -hex 64
JWT_SECRET=replace_with_a_strong_jwt_secret_generated_by_openssl_rand_hex_64

# 主服务与 AI 服务内部接口令牌（身份内省、用户数据清理）
LIUTECH_INTERNAL_TOKEN=replace_with_a_strong_internal_service_token

# 数据库密码：生产环境必须替换为强密码
DB_PASSWORD=replace_with_mysql_root_password

# 应用数据库账户密码（非 root 最小权限账户，须与已创建的数据库账户一致）
DB_APP_PASSWORD=replace_with_app_db_password
DB_AI_APP_PASSWORD=replace_with_ai_app_db_password

# AI 服务 API 密钥
SPRING_AI_OPENAI_API_KEY=replace_with_ai_model_api_key

# SiliconFlow 通用 API Key：仅 AI 服务读取
SILICONFLOW_API_KEY=replace_with_siliconflow_api_key

# SiliconFlow TTS API Key：只给 AI 服务读取，用于云端语音推理
# 如果不配置，AI 服务会依次尝试 SILICONFLOW_API_KEY 和 SPRING_AI_OPENAI_API_KEY
SILICONFLOW_TTS_API_KEY=replace_with_tts_api_key

# TTS 推理并发上限，默认1以保护单卡 GPT-SoVITS
TTS_CONCURRENCY=1

# AI 限流仅信任实际直连 Nginx 的地址或 CIDR（逗号分隔），默认忽略 X-Real-IP/XFF。
# 先核实 Docker 网络/代理地址再填写；不要信任任意公网地址或整个 0.0.0.0/0。
# CDN 回源默认按 CDN 连接地址限流，真实客户端链须另外配置并校验可信 CDN，不能直接读 XFF 首段。
AI_TRUSTED_PROXIES=

# 可选的全局成本护栏；0 保持管理端每个模型的 maxTokens/contextWindow 为权威。
AI_MODEL_MAX_OUTPUT_TOKENS=0
AI_MODEL_MAX_INPUT_TOKENS=0

# 每个服务可独立固定镜像版本；本地不填时使用 latest
# BACKEND_IMAGE_TAG=git_sha_or_release_tag
# AI_IMAGE_TAG=git_sha_or_release_tag
# WEB_IMAGE_TAG=git_sha_or_release_tag
# ADMIN_IMAGE_TAG=git_sha_or_release_tag
# NGINX_IMAGE_TAG=git_sha_or_release_tag

# 应用基础 URL：用于生成绝对文件 URL 和邮件链接，必须与实际访问入口一致。
# 云端现行值带 www；本机写 3000 端口，不要写 http://localhost（无端口会命中
# nginx:80 并 301 跳到生产域名，本地生成的链接就指向线上）。
SERVER_BASE_URL=https://www.liuxin.chat
# 本机替代：SERVER_BASE_URL=http://localhost:3000

# 邮箱 SMTP 配置（忘记密码、邮箱验证码登录）
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=replace_with_email@qq.com
MAIL_PASSWORD=replace_with_smtp_authorization_code
MAIL_FROM=replace_with_email@qq.com
MAIL_DISPLAY_NAME=LiuTech博客
# 只控制健康检查，不关闭邮件功能。云端 SMTP 可用，保持 true。
MAIL_HEALTH_ENABLED=true
# 本机替代（跳过 SMTP 探测）：MAIL_HEALTH_ENABLED=false

# ===== 路径配置（宿主机目录）=====
# 注释或不配置则使用 docker-compose.yml 里的默认值（适合本地开发）
# 生产环境必须取消注释并填服务器绝对路径

# 文件上传持久化目录（默认 ./uploads）；uploads 不带 ./ 时使用项目的命名卷。
# 已有环境保留当前选择，切换路径/卷之前先迁移文件。
# UPLOADS_PATH=uploads
# UPLOADS_PATH=./uploads
# UPLOADS_PATH=/liuxin/uploads

# 日志持久化目录，backend 和 ai 共用，文件名区分（默认 ./logs）
# LOGS_PATH=./logs
# LOGS_PATH=/liuxin/logs

# Nginx SSL 证书目录（默认 ./nginx/certs）
# NGINX_SSL_PATH=./nginx/certs
# NGINX_SSL_PATH=/opt/liutech/nginx

# ===== 腾讯云 COS 对象存储（可选）=====
# 启用后图片/文档/音乐上传到 COS，URL 直出 COS 域名（省服务器磁盘和带宽）
# 密钥在腾讯云控制台-访问管理(CAM)创建，建议子账号密钥并只授权给本桶
# COS_ENABLED=false
# COS_ENABLED=true
# COS_SECRET_ID=your_cos_secret_id
# COS_SECRET_KEY=your_cos_secret_key
# COS_REGION=ap-chongqing
# COS_BUCKET=liutech-1341692466
# 自定义访问域名（可选）：绑定 COS 自定义源站域名并配好证书后，填 https://static.liuxin.chat
# 不填则用 COS 默认域名
# COS_BASE_URL=
# 一次性迁移：本地 uploads 全量传 COS（跑完看日志，确认后移除）
# COS_MIGRATE=false
