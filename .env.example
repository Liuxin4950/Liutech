# 基础端口配置
WEB_PORT=3000
ADMIN_PORT=3001
BACKEND_PORT=8080
MYSQL_PORT=3306
NGINX_HTTP=80
NGINX_HTTPS=443
AI_PORT=8081

# JWT 签名密钥：后端和 AI 服务必须保持一致
# 生成示例：openssl rand -base64 64
JWT_SECRET=replace_with_a_strong_jwt_secret_min_32_chars

# 数据库密码：生产环境必须替换为强密码
DB_PASSWORD=replace_with_mysql_root_password

# AI 服务 API 密钥
SPRING_AI_OPENAI_API_KEY=replace_with_siliconflow_api_key

# 应用基础 URL
SERVER_BASE_URL=http://localhost
