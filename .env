# =====================
# 基础端口配置
# =====================
WEB_PORT=3000
ADMIN_PORT=3001
BACKEND_PORT=8080
MYSQL_PORT=3306
NGINX_HTTP=80
NGINX_HTTPS=443
AI_PORT=8081

# =====================
# 生产环境敏感配置
# 仅用于 Docker 部署
# 请勿加入版本控制
# =====================

# JWT签名密钥 - 后端和AI服务共用此密钥
# 生成强密钥命令：openssl rand -base64 64
JWT_SECRET=your_production_jwt_secret_min_256_bits

# 数据库密码 - 生产环境使用强密码
# 注意：此密码需与 MySQL 容器和后端配置一致
DB_PASSWORD=your_production_db_password

# AI服务API密钥 - 硅基流动
# 开发环境可保留原有密钥，生产环境请替换为真实密钥
SPRING_AI_OPENAI_API_KEY="sk-mgeqjwqoregdyyngyospzepxvidnkapkxupvatavqzhtcujo"
